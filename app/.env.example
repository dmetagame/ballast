# Existing published manager remains read-only by default.
VITE_BALLAST_MANAGER=0x379e5B8Cf31fC5D46aEc2fc17F17708951015571
VITE_ENABLE_ENROLLMENT_WRITES=false
VITE_MANAGER_VERSION=v1

# For a future hardened manager deployment, set all values explicitly:
# VITE_BALLAST_MANAGER=0xYourFutureManager
# VITE_ENABLE_ENROLLMENT_WRITES=true
# VITE_MANAGER_VERSION=v3
