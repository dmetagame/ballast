[Unit]
Description=Ballast V3 protection keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ballast-runtime-current/monitor
EnvironmentFile=%h/.config/ballast/keeper.env
ExecStart=/usr/bin/env EXECUTE=false npm run keeper:watch
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/ballast
InaccessiblePaths=-%h/.config/ballast/keeper.private-key

[Install]
WantedBy=default.target
