ballast.rouma.online {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@static path /product/* /risk/* /enroll/*
	header @static {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://flare-api.flare.network"
		Cache-Control "no-cache"
	}

	@hashedAssets path /product/assets/* /enroll/assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	@ops path /ops/health.json
	header @ops {
		Content-Type "application/json"
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	}
	handle @ops {
		root * /var/www/ballast-ops
		try_files /health.json =503
		file_server
	}

	@product path /product
	redir @product /product/ 308
	handle_path /product/* {
		root * /var/www/ballast-current/landing
		file_server
	}

	@risk path /risk
	redir @risk /risk/ 308
	handle_path /risk/* {
		root * /var/www/ballast-current/dashboard
		file_server
	}

	@enroll path /enroll
	redir @enroll /enroll/ 308
	handle_path /enroll/* {
		root * /var/www/ballast-current/enrollment
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:6674
	}
}
