NODE_OPTIONS=--dns-result-order=ipv4first
BALLAST=0x746066ACe5dc89a3692137b8cdE3c31328629d09
MANAGER_VERSION=v3
FROM_BLOCK=67019411
# STATE_FILE defaults to ~/.config/ballast/keeper-state.json
BLOCKSCOUT_URL=https://flare-explorer.flare.network
CONFIRMATION_BLOCKS=12
RPC_LOG_PAGE_BLOCKS=30
LOG_QUERY_CONCURRENCY=4
RUN_ONCE=true
EXECUTE=false
POLL_INTERVAL_MS=30000
MAX_CONCURRENCY=4
MAX_POSITIONS=0
# Supply the protected keeper key even in dry-run to verify V3 policy/operator matching.
# PRIVATE_KEY_FILE=/run/secrets/ballast-keeper-key
# Set these production economics thresholds before enabling execution:
# MAX_GAS_FLR_WEI=
# MIN_KEEPER_FEE_UNITS=
# LOAN_TOKEN_UNITS_PER_FLR=
# MIN_PROFIT_FLR_WEI=
