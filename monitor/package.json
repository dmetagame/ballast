{
  "name": "ballast-monitor",
  "private": true,
  "type": "module",
  "description": "Risk scanners for FXRP-collateralised leverage on Flare (Morpho Blue + Enosys isolated markets).",
  "scripts": {
    "scan:morpho": "node scan-morpho-markets.mjs && node scan-morpho-health.mjs",
    "scan:enosys": "node scan-enosys-borrowers.mjs && node scan-enosys-health.mjs",
    "keeper:dry-run": "RUN_ONCE=true node keeper.mjs",
    "keeper:execute": "EXECUTE=true RUN_ONCE=true node keeper.mjs",
    "keeper:watch": "node keeper.mjs",
    "keeper:execute-watch": "EXECUTE=true node keeper.mjs",
    "healthcheck": "node healthcheck.mjs",
    "verify:controlled": "node verify-controlled-receipt.mjs",
    "test": "node --test *.test.mjs"
  },
  "dependencies": {
    "viem": "^2.21.0"
  }
}
